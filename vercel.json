{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "zorix-ai.vercel.app"
        }
      ],
      "destination": "https://zoriix.tech/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "rafiq-ai-delta.vercel.app"
        }
      ],
      "destination": "https://zoriix.tech/$1",
      "permanent": true
    },
    {
      "source": "/services/voice-agent",
      "destination": "/automation/reply/",
      "permanent": false
    },
    {
      "source": "/services/voice-agent/",
      "destination": "/automation/reply/",
      "permanent": false
    },
    {
      "source": "/services",
      "destination": "/#topics",
      "permanent": true
    },
    {
      "source": "/services/",
      "destination": "/#topics",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/og/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/((?!assets/|og/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
